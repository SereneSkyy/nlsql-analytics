# Postgres connection (Supabase pooler URL in production, local Docker in dev)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Google Gemini API
GEMINI_API_KEY=your_key_here

# Optional: override the model used for SQL generation/eval (defaults to gemini-3.6-flash)
GEMINI_MODEL=gemini-flash-lite-latest
